{
  "name": "clareza-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Demonstra\u00e7\u00e3o est\u00e1tica do Clareza com dados fict\u00edcios e processamento local.",
  "engines": {
